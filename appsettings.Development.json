{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/touristroutes-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=myServer;Database=TouristRoutesDB;User Id=admin;Password=SuperSecretPassword123;TrustServerCertificate=True;"
  },

  "SmtpSettings": {
    "Host": "smtp.mycompany.com",
    "Port": 587,
    "Username": "admin@mycompany.com",
    "Password": "EmailPassword123",
    "EnableSsl": true
  },

  "MapApiSettings": {
    "BaseUrl": "https://maps.api.com",
    "ApiKey": "sk_test_1234567890abcdef"
  }
}